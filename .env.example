# 사우나우 환경변수 — 이 파일을 .env.local 로 복사해 채운다.
# .env* 는 .gitignore 에 걸려 있다. 실제 키를 이 파일에 적지 말 것.

# ── 필수: 앱이 이것 없이는 빌드도 되지 않는다 ────────────────────────────
# 홈·지도·읽을거리가 ISR 로 프리렌더되며 빌드 타임에 Supabase 를 조회한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 절대 URL(사이트맵·robots·OG·매니페스트)의 기준. 미설정이면 Vercel 프로덕션 도메인 →
# 그것도 없으면 https://saunau.vercel.app. 커스텀 도메인을 붙이면 여기만 바꾼다.
NEXT_PUBLIC_SITE_URL=

# ── 사실상 필수 ──────────────────────────────────────────────────────
# 없으면 지도가 "지도를 불러올 수 없어요" 상태로 뜬다.
# https://console.ncloud.com → Maps → Web Dynamic Map (서비스 URL 등록 필요)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── 서버 전용(브라우저에 절대 노출 금지) ──────────────────────────────
# 사진 업로드·모더레이션·관리자 API·적재 스크립트가 RLS 를 우회할 때 쓴다.
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 이메일(쉼표 구분) — 사진 검수·즉시 게시 권한.
ADMIN_EMAILS=

# ── 공공데이터 동기화 Cron(/api/cron/sync, vercel.json 에서 매일 03:00 KST) ──
# Vercel Cron 이 보내는 Authorization 헤더와 대조하는 값.
CRON_SECRET=
# 공공데이터포털 목욕장업 인허가 API 키.
PUBLIC_DATA_API_KEY=
# 좌표 없는 매장 지오코딩(선택). 없으면 지오코딩 단계만 건너뛴다.
KAKAO_REST_API_KEY=

# ── 수집 스크립트(선택 — 앱 구동에는 불필요) ───────────────────────────
# 네이버 검색 API(블로그 후기). https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글 Places(사진·평점 보강).
GOOGLE_MAPS_API_KEY=
# (현재 미사용) 사진 업로드는 운영자 전용이라 모더레이션을 호출하지 않는다.
# 일반 회원 업로드를 다시 열면 lib/moderation 이 이 키를 쓴다 —
# 키가 없으면 fail-closed(업로드 전부 거부)이므로 그때는 반드시 채워야 한다.
GOOGLE_VISION_API_KEY=
# 소개문 생성 모델 — scripts/describe.ts 가 claude CLI 를 헤드리스로 호출한다.
# (API 키가 아니라 로그인된 클로드 플랜으로 동작)
DESCRIBE_MODEL=

# ── 런타임 킬스위치(선택) ────────────────────────────────────────────
# DB 플래그(system_flags 테이블)가 1순위이고, 이것은 DB 장애 시 폴백. 기본 on.
NEXT_PUBLIC_IMAGES_ENABLED=true
NEXT_PUBLIC_BLOG_REVIEWS_ENABLED=true
